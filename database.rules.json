{
  "rules": {
    ".read": false,
    ".write": false,
    "t": {
      "$code": {
        ".read": "$code.length >= 16",
        ".write": "$code.length >= 16"
      }
    },
    "s": {
      "$code": {
        ".read": "$code.length >= 12",
        ".write": "$code.length >= 12"
      }
    }
  }
}
